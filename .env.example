# Server-only production environment variables
# Never expose these through NEXT_PUBLIC_* variables.
NOTION_API_KEY=replace_with_notion_integration_secret
NOTION_READING_DB_ID=replace_with_reading_status_database_id
NOTION_READING_DATA_SOURCE_ID=replace_with_reading_queue_data_source_id
QUEUE_BACKEND=notion

# Optional explicit data source IDs. The app has safe fallback IDs for the current project,
# but set these in the hosting dashboard for production configuration clarity.
NOTION_QA_DATA_SOURCE_ID=replace_with_q_and_a_data_source_id
NOTION_RELATIONSHIP_DATA_SOURCE_ID=replace_with_relationship_data_source_id
NOTION_SPECIAL_DATA_SOURCE_ID=replace_with_special_pack_data_source_id
NOTION_DEEP_READING_DATA_SOURCE_ID=replace_with_deep_reading_data_source_id
NOTION_CALL_DATA_SOURCE_ID=replace_with_call_pack_data_source_id
